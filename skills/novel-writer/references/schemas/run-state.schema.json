{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/novel-writer/run-state.schema.json",
  "title": "Novel Writer Prose Run State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "updated_at",
    "mode",
    "work_unit",
    "operation",
    "revision_level",
    "stages"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*-[0-9]{8}-[0-9]{3,}$"
    },
    "created_at": {
      "$ref": "#/$defs/nullableDateTime"
    },
    "updated_at": {
      "$ref": "#/$defs/nullableDateTime"
    },
    "mode": {
      "enum": ["fast", "standard", "production"]
    },
    "work_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "enum": ["chapter", "scene", "one_shot"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "operation": {
      "enum": ["generate", "regenerate", "revise", "audit"]
    },
    "revision_level": {
      "type": ["string", "null"],
      "enum": ["light", "deep", null]
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preflight",
        "draft_writing",
        "content_review",
        "prose_refinement",
        "story_fact_check",
        "final_verification",
        "promotion_state_update"
      ],
      "properties": {
        "preflight": {
          "$ref": "#/$defs/stageRecord"
        },
        "draft_writing": {
          "$ref": "#/$defs/stageRecord"
        },
        "content_review": {
          "$ref": "#/$defs/stageRecord"
        },
        "prose_refinement": {
          "$ref": "#/$defs/stageRecord"
        },
        "story_fact_check": {
          "$ref": "#/$defs/stageRecord"
        },
        "final_verification": {
          "$ref": "#/$defs/stageRecord"
        },
        "promotion_state_update": {
          "$ref": "#/$defs/stageRecord"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "revise"
          }
        },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "revision_level": {
            "enum": ["light", "deep"]
          }
        }
      },
      "else": {
        "properties": {
          "revision_level": {
            "const": null
          }
        }
      }
    }
  ],
  "$defs": {
    "nullableDateTime": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "stageStatus": {
      "enum": [
        "pending",
        "active",
        "paused",
        "passed",
        "blocked",
        "stale",
        "cancelled",
        "not_applicable"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": ["integer", "string", "null"]
        },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "observed_modified_at": {
          "$ref": "#/$defs/nullableDateTime"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["message"],
      "properties": {
        "severity": {
          "enum": ["critical", "major", "minor", "info"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": ["string", "null"]
        },
        "owner": {
          "type": ["string", "null"]
        }
      }
    },
    "componentRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "$ref": "#/$defs/stageStatus"
        },
        "started_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "completed_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "execution_batch": {
          "type": ["string", "null"]
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "blocking_reason": {
          "type": ["string", "null"]
        },
        "not_applicable_reason": {
          "type": ["string", "null"]
        },
        "notes": {
          "type": ["string", "null"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "blocked"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["blocking_reason"],
            "properties": {
              "blocking_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_applicable"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["not_applicable_reason"],
            "properties": {
              "not_applicable_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "stageRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "$ref": "#/$defs/stageStatus"
        },
        "started_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "completed_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "execution_batch": {
          "type": ["string", "null"]
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "blocking_reason": {
          "type": ["string", "null"]
        },
        "not_applicable_reason": {
          "type": ["string", "null"]
        },
        "notes": {
          "type": ["string", "null"]
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["character_review", "lore_continuity_audit"],
          "properties": {
            "character_review": {
              "$ref": "#/$defs/componentRecord"
            },
            "lore_continuity_audit": {
              "$ref": "#/$defs/componentRecord"
            }
          }
        },
        "passes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prose_stylist", "narrative_humanizer"],
          "properties": {
            "prose_stylist": {
              "$ref": "#/$defs/componentRecord"
            },
            "narrative_humanizer": {
              "$ref": "#/$defs/componentRecord"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "blocked"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["blocking_reason"],
            "properties": {
              "blocking_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_applicable"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["not_applicable_reason"],
            "properties": {
              "not_applicable_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
