{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/novel-writer/run-index.schema.json",
  "title": "Novel Writer Run Selection Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_units"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "work_units": {
      "type": "object",
      "default": {},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["selected_run_id"],
        "properties": {
          "selected_run_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*-[0-9]{8}-[0-9]{3,}$"
          }
        }
      }
    }
  }
}
